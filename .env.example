# ─────────────────────────────────────────────────────────────────────────────
# ARTECI — Variables d'environnement
# Copiez ce fichier en ".env" et adaptez les valeurs
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=arteci-api

# ── Traitement ────────────────────────────────────────────────────────────────
# Nombre de lignes par chunk (fichiers volumineux)
CHUNK_SIZE=100000
# Nombre de lignes retournées dans l'aperçu
PREVIEW_ROWS=100

# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=8000
WORKERS=4
